# ===== 数据库（Neon Postgres，免费）=====
# 在 https://console.neon.tech 创建项目后复制连接串
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ===== SMTP 发信（用你自己的邮箱）=====
# QQ 邮箱：smtp.qq.com，465，授权码
# 163 邮箱：smtp.163.com，465，授权码
# Gmail：smtp.gmail.com，465，应用专用密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@qq.com
SMTP_PASS=你的授权码

# 发件人（可选，默认等于 SMTP_USER）
FROM_EMAIL=

# ===== 定时任务鉴权密钥 =====
# Vercel 部署时会自动注入 CRON_SECRET，无需手动填写；
# 本地调试 cron 接口时如设置了此变量则需在请求头带上 Authorization: Bearer <值>
CRON_SECRET=
