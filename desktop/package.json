{
  "name": "pingan-checkin-desktop",
  "version": "1.0.0",
  "description": "平安签到桌面端（本地后端直连数据库，免代理）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.5",
    "express": "^4.22.3",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.pingan.checkin",
    "productName": "平安签到",
    "files": [
      "main.js",
      "server.js",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config.json",
        "to": "config.json"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    }
  }
}
